      },
      "html": "\n<div class=\"bg-white text-[#00009C] font-['Inter'] selection:bg-[#FFC40C] selection:text-[#00009C]\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=Inter:wght@400;500;700&display=swap');\n        \n        .font-space { font-family: 'Space+Grotesk', sans-serif; }\n        .font-inter { font-family: 'Inter', sans-serif; }\n        \n        .custom-cursor {\n            width: 20px;\n            height: 20px;\n            background: #FFC40C;\n            border-radius: 50%;\n            position: fixed;\n            pointer-events: none;\n            z-index: 9999;\n            mix-blend-mode: difference;\n        }\n\n        .clip-path-asymmetric {\n            clip-path: polygon(0 0, 100% 0, 100% 100%, 15% 100%);\n        }\n        \n        @media (max-width: 1024px) {\n            .clip-path-asymmetric {\n                clip-path: none;\n            }\n        }\n    </style>\n\n    \n    <header class=\"fixed top-0 left-0 w-full z-50 mix-blend-difference px-12 py-8 flex justify-between items-center pointer-events-none\" data-kid=\"2\">\n        <div class=\"pointer-events-auto\" data-kid=\"3\">\n            <a href=\"#\" class=\"text-2xl font-['Space_Grotesk'] font-bold tracking-tighter text-white flex items-center gap-2\" data-kid=\"4\">\n                <div class=\"w-8 h-8 bg-[#FFC40C] rounded-xs flex items-center justify-center text-[#00009C]\" data-kid=\"5\">\n                    <i class=\"ph-bold ph-navigation-arrow\" data-kid=\"6\"></i>\n                </div>\n                ONMOVE\n            </a>\n        </div>\n        <nav class=\"hidden md:flex gap-12 text-[10px] uppercase tracking-[0.3em] font-bold text-white pointer-events-auto\" data-kid=\"7\">\n            <a href=\"#solutions\" class=\"hover:text-[#FFC40C] transition-colors\" data-kid=\"8\">Solutions</a>\n            <a href=\"#network\" class=\"hover:text-[#FFC40C] transition-colors\" data-kid=\"9\">Network</a>\n            <a href=\"#mission\" class=\"hover:text-[#FFC40C] transition-colors\" data-kid=\"10\">Mission</a>\n            <a href=\"#contact\" class=\"hover:text-[#FFC40C] transition-colors underline decoration-[#FFC40C] underline-offset-8\" data-kid=\"11\">Join Now</a>\n        </nav>\n    </header>\n\n    \n    <section class=\"relative min-h-screen flex flex-col lg:flex-row overflow-hidden bg-[#00009C]\" data-kid=\"12\">\n        \n        <div class=\"lg:w-1/2 p-12 lg:p-24 flex flex-col justify-center relative z-10 text-white\" data-kid=\"13\">\n            <div class=\"hero-content\" data-kid=\"14\">\n                <div class=\"hero-animate-item inline-flex items-center gap-3 mb-8\" data-kid=\"15\">\n                    <span class=\"w-12 h-[2px] bg-[#FFC40C]\" data-kid=\"16\"></span>\n                    <span class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#FFC40C]\" data-kid=\"17\">Strategic Mobility</span>\n                </div>\n                \n                <h1 class=\"hero-animate-item text-6xl md:text-8xl font-['Space_Grotesk'] font-bold leading-[0.85] tracking-tighter mb-12\" data-kid=\"18\">\n                    MOVE <br data-kid=\"19\">TOGETHER. <br data-kid=\"20\">\n                    <span class=\"text-[#FFC40C]\" data-kid=\"21\">SAVE</span> TOGETHER.\n                </h1>\n                \n                <p class=\"hero-animate-item text-lg md:text-xl text-white/70 max-w-md mb-12 leading-relaxed\" data-kid=\"22\">\n                    A community-driven mobility network designed for peak efficiency. Reduce urban congestion and personal costs through data-led journey optimization.\n                </p>\n                \n                <div class=\"hero-animate-item flex flex-wrap gap-6\" data-kid=\"23\">\n                    <button class=\"hero-btn-primary px-10 py-5 bg-[#FFC40C] text-[#00009C] font-bold uppercase tracking-tighter rounded-xs hover:bg-white transition-all flex items-center gap-3\" data-kid=\"24\">\n                        Find A Journey\n                        <i class=\"ph-bold ph-arrow-up-right\" data-kid=\"25\"></i>\n                    </button>\n                    <button class=\"hero-btn-secondary px-10 py-5 border border-white/30 text-white font-bold uppercase tracking-tighter rounded-xs hover:bg-white hover:text-[#00009C] transition-all\" data-kid=\"26\">\n                        Post A Route\n                    </button>\n                </div>\n            </div>\n            \n            <div class=\"mt-24 grid grid-cols-2 gap-12 opacity-50 hero-stats\" data-kid=\"27\">\n                <div class=\"stat-animate-item\" data-kid=\"28\">\n                    <div class=\"text-4xl font-['Space_Grotesk'] font-bold\" data-kid=\"29\">42M+</div>\n                    <div class=\"text-[10px] uppercase tracking-widest font-bold\" data-kid=\"30\">Km Shared</div>\n                </div>\n                <div class=\"stat-animate-item\" data-kid=\"31\">\n                    <div class=\"text-4xl font-['Space_Grotesk'] font-bold\" data-kid=\"32\">186k</div>\n                    <div class=\"text-[10px] uppercase tracking-widest font-bold\" data-kid=\"33\">Daily Commutes</div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"lg:w-1/2 relative bg-black\" data-kid=\"34\">\n            <div class=\"absolute inset-0 grayscale group overflow-hidden\" data-kid=\"35\">\n                <img src=\"https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&w=1400&q=80&fit=crop\" alt=\"Urban Traffic Macro\" class=\"hero-img w-full h-full object-cover opacity-60 scale-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"36\">\n            </div>\n            <div class=\"absolute inset-0 bg-[#00009C]/30 mix-blend-multiply\" data-kid=\"37\"></div>\n            \n            \n            <div class=\"absolute top-1/2 left-0 -translate-y-1/2 w-full h-full pointer-events-none flex items-center justify-center\" data-kid=\"38\">\n                <div class=\"w-full max-w-lg aspect-square border border-white/10 rounded-full animate-[spin_20s_linear_infinite]\" data-kid=\"39\"></div>\n            </div>\n\n            <div class=\"absolute bottom-12 right-12 text-right text-white\" data-kid=\"40\">\n                <div class=\"text-[80px] font-['Space_Grotesk'] font-bold leading-none opacity-20\" data-kid=\"41\">01</div>\n                <div class=\"text-xs uppercase tracking-[0.4em] font-bold text-[#FFC40C]\" data-kid=\"42\">System Logic</div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"solutions\" class=\"py-32 px-12 bg-white relative\" data-kid=\"43\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"44\">\n            <div class=\"flex flex-col lg:flex-row gap-24 items-start mb-32\" data-kid=\"45\">\n                <div class=\"lg:w-1/3 section-header\" data-kid=\"46\">\n                    <h2 class=\"text-5xl font-['Space_Grotesk'] font-bold leading-none tracking-tighter mb-8\" data-kid=\"47\">\n                        THE UTILITY<br data-kid=\"48\">OF SCALE.\n                    </h2>\n                    <p class=\"text-slate-500 text-lg leading-relaxed mb-12\" data-kid=\"49\">\n                        OnMove operates on a high-precision logistical framework, connecting users via verified routes to maximize resource utility.\n                    </p>\n                    <a href=\"#\" class=\"inline-flex items-center gap-4 font-bold uppercase tracking-widest text-xs group\" data-kid=\"50\">\n                        Read Whitepaper\n                        <span class=\"w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center group-hover:bg-[#00009C] group-hover:text-white transition-all\" data-kid=\"51\">\n                            <i class=\"ph-bold ph-arrow-right\" data-kid=\"52\"></i>\n                        </span>\n                    </a>\n                </div>\n                \n                <div class=\"lg:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-px bg-slate-200 border border-slate-200 rounded-xs overflow-hidden shadow-2xl shadow-slate-200\" data-kid=\"53\">\n                    \n                    <div class=\"grid-card-item bg-white p-12 hover:bg-[#00009C] group transition-all duration-500\" data-kid=\"54\">\n                        <div class=\"w-14 h-14 bg-[#00009C]/5 rounded-xs flex items-center justify-center mb-10 group-hover:bg-[#FFC40C] transition-colors\" data-kid=\"55\">\n                            <i class=\"ph-bold ph-strategy text-2xl text-[#00009C]\" data-kid=\"56\"></i>\n                        </div>\n                        <h3 class=\"text-2xl font-['Space_Grotesk'] font-bold mb-4 group-hover:text-white transition-colors\" data-kid=\"57\">Dynamic Matching</h3>\n                        <p class=\"text-slate-600 group-hover:text-white/70 transition-colors leading-relaxed\" data-kid=\"58\">\n                            Algorithmic route intersection analysis ensures minimal detours for maximum savings.\n                        </p>\n                    </div>\n                    \n                    <div class=\"grid-card-item bg-white p-12 hover:bg-[#00009C] group transition-all duration-500\" data-kid=\"59\">\n                        <div class=\"w-14 h-14 bg-[#00009C]/5 rounded-xs flex items-center justify-center mb-10 group-hover:bg-[#FFC40C] transition-colors\" data-kid=\"60\">\n                            <i class=\"ph-bold ph-shield-check text-2xl text-[#00009C]\" data-kid=\"61\"></i>\n                        </div>\n                        <h3 class=\"text-2xl font-['Space_Grotesk'] font-bold mb-4 group-hover:text-white transition-colors\" data-kid=\"62\">Identity Trust</h3>\n                        <p class=\"text-slate-600 group-hover:text-white/70 transition-colors leading-relaxed\" data-kid=\"63\">\n                            Every participant is verified through our 3-tier security protocol ensuring total network integrity.\n                        </p>\n                    </div>\n                    \n                    <div class=\"grid-card-item bg-white p-12 hover:bg-[#00009C] group transition-all duration-500\" data-kid=\"64\">\n                        <div class=\"w-14 h-14 bg-[#00009C]/5 rounded-xs flex items-center justify-center mb-10 group-hover:bg-[#FFC40C] transition-colors\" data-kid=\"65\">\n                            <i class=\"ph-bold ph-lightning text-2xl text-[#00009C]\" data-kid=\"66\"></i>\n                        </div>\n                        <h3 class=\"text-2xl font-['Space_Grotesk'] font-bold mb-4 group-hover:text-white transition-colors\" data-kid=\"67\">Instant Payouts</h3>\n                        <p class=\"text-slate-600 group-hover:text-white/70 transition-colors leading-relaxed\" data-kid=\"68\">\n                            Frictionless cost-splitting settled instantly upon arrival via our integrated ledger system.\n                        </p>\n                    </div>\n                    \n                    <div class=\"grid-card-item bg-white p-12 hover:bg-[#00009C] group transition-all duration-500\" data-kid=\"69\">\n                        <div class=\"w-14 h-14 bg-[#00009C]/5 rounded-xs flex items-center justify-center mb-10 group-hover:bg-[#FFC40C] transition-colors\" data-kid=\"70\">\n                            <i class=\"ph-bold ph-chart-bar text-2xl text-[#00009C]\" data-kid=\"71\"></i>\n                        </div>\n                        <h3 class=\"text-2xl font-['Space_Grotesk'] font-bold mb-4 group-hover:text-white transition-colors\" data-kid=\"72\">Carbon Ledger</h3>\n                        <p class=\"text-slate-600 group-hover:text-white/70 transition-colors leading-relaxed\" data-kid=\"73\">\n                            Track your individual contribution to emission reduction with real-time ecological auditing.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"relative h-[80vh] bg-black overflow-hidden group\" data-kid=\"74\">\n        <video src=\"https://player.vimeo.com/external/494252666.sd.mp4?s=338c351475c7e10887349788f62f32f84b633f81&profile_id=164&oauth2_token_id=57447761\" poster=\"https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?auto=format&w=1200&q=80&fit=crop\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-[2s]\" data-kid=\"75\"></video>\n        <div class=\"absolute inset-0 flex flex-col items-center justify-center text-center p-12 bg-gradient-to-b from-[#00009C]/40 to-transparent\" data-kid=\"76\">\n            <h2 class=\"text-white text-4xl md:text-6xl font-['Space_Grotesk'] font-bold mb-8 max-w-4xl tracking-tighter\" data-kid=\"77\">\n                OPTIMIZED FOR THE <br data-kid=\"78\"><span class=\"text-[#FFC40C]\" data-kid=\"79\">URBAN PULSE</span>\n            </h2>\n            <div class=\"flex gap-4\" data-kid=\"80\">\n                <div class=\"w-1 h-12 bg-[#FFC40C]\" data-kid=\"81\"></div>\n                <div class=\"w-1 h-12 bg-white/20\" data-kid=\"82\"></div>\n                <div class=\"w-1 h-12 bg-white/20\" data-kid=\"83\"></div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"contact\" class=\"bg-[#00009C] py-32 px-12 text-white relative overflow-hidden\" data-kid=\"84\">\n        <div class=\"absolute top-0 right-0 w-1/2 h-full bg-[#FFC40C] -skew-x-12 translate-x-1/2 opacity-5\" data-kid=\"85\"></div>\n        <div class=\"max-w-4xl mx-auto text-center relative z-10\" data-kid=\"86\">\n            <div class=\"text-[10px] font-bold uppercase tracking-[0.5em] text-[#FFC40C] mb-8\" data-kid=\"87\">Ready to Scale?</div>\n            <h2 class=\"text-5xl md:text-7xl font-['Space_Grotesk'] font-bold mb-12 tracking-tighter leading-none\" data-kid=\"88\">\n                START YOUR NEXT <br data-kid=\"89\">EFFICIENT JOURNEY.\n            </h2>\n            <form class=\"flex flex-col md:flex-row gap-4 max-w-2xl mx-auto\" data-kid=\"90\">\n                <input type=\"email\" placeholder=\"ENTER YOUR WORK EMAIL\" class=\"grow bg-white/10 border border-white/20 px-8 py-5 rounded-xs focus:outline-hidden focus:border-[#FFC40C] text-sm font-bold tracking-widest uppercase transition-all\" data-kid=\"91\">\n                <button class=\"bg-[#FFC40C] text-[#00009C] px-10 py-5 font-bold uppercase tracking-tighter rounded-xs hover:bg-white transition-all whitespace-nowrap\" data-kid=\"92\">\n                    Join Network\n                </button>\n            </form>\n        </div>\n    </section>\n\n    \n    <footer class=\"bg-white py-20 px-12 border-t border-slate-100\" data-kid=\"93\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12\" data-kid=\"94\">\n            <div class=\"text-xl font-['Space_Grotesk'] font-bold tracking-tighter text-[#00009C] flex items-center gap-2\" data-kid=\"95\">\n                <div class=\"w-6 h-6 bg-[#00009C] rounded-xs flex items-center justify-center text-white\" data-kid=\"96\">\n                    <i class=\"ph-bold ph-navigation-arrow text-xs\" data-kid=\"97\"></i>\n                </div>\n                ONMOVE\n            </div>\n            \n            <div class=\"flex gap-12 text-[10px] font-bold uppercase tracking-widest text-slate-400\" data-kid=\"98\">\n                <a href=\"#\" class=\"hover:text-[#00009C] transition-colors\" data-kid=\"99\">Privacy</a>\n                <a href=\"#\" class=\"hover:text-[#00009C] transition-colors\" data-kid=\"100\">Terms</a>\n                <a href=\"#\" class=\"hover:text-[#00009C] transition-colors\" data-kid=\"101\">Security</a>\n                <a href=\"#\" class=\"hover:text-[#00009C] transition-colors\" data-kid=\"102\">Status</a>\n            </div>\n            \n            <div class=\"text-[10px] font-bold uppercase tracking-widest text-slate-300\" data-kid=\"103\">\n                © 2024 ONMOVE LOGISTICS INC.\n            </div>\n        </div>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"104\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"105\"></script>\n    <script src=\"https://unpkg.com/@phosphor-icons/web\" data-kid=\"106\"></script>\n    <script type=\"module\" data-kid=\"107\">\n        import { animate, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Hero Animations\n        gsap.to(\".hero-img\", {\n            scale: 1,\n            opacity: 0.8,\n            duration: 2.5,\n            ease: \"expo.out\"\n        });\n\n        gsap.from(\".hero-animate-item\", {\n            y: 50,\n            opacity: 0,\n            stagger: 0.1,\n            duration: 1.5,\n            ease: \"expo.out\",\n            delay: 0.5\n        });\n\n        gsap.from(\".stat-animate-item\", {\n            y: 30,\n            opacity: 0,\n            stagger: 0.2,\n            duration: 1,\n            ease: \"power2.out\",\n            delay: 1.2\n        });\n\n        // Scroll Based Animations\n        inView(\".section-header\", ({ target }) => {\n            animate(target, { opacity: [0, 1], x: [-50, 0] }, { duration: 0.8, easing: \"ease-out\" });\n        });\n\n        inView(\".grid-card-item\", ({ target }) => {\n            animate(target, { opacity: [0, 1], y: [50, 0] }, { duration: 0.6, easing: \"ease-out\" });\n        });\n\n        // Parallax effect on hero background\n        gsap.to(\".hero-img\", {\n            yPercent: 20,\n            ease: \"none\",\n            scrollTrigger: {\n                trigger: \"section\",\n                start: \"top top\",\n                end: \"bottom top\",\n                scrub: true\n            }\n        });\n\n        // Custom Cursor Interaction\n        const cursor = document.createElement('div');\n        cursor.className = 'custom-cursor';\n        document.body.appendChild(cursor);\n\n        document.addEventListener('mousemove', e => {\n            gsap.to(cursor, {\n                x: e.clientX - 10,\n                y: e.clientY - 10,\n                duration: 0.2\n            });\n        });\n\n        document.querySelectorAll('a, button').forEach(el => {\n            el.addEventListener('mouseenter', () => gsap.to(cursor, { scale: 3, duration: 0.3 }));\n            el.addEventListener('mouseleave', () => gsap.to(cursor, { scale: 1, duration: 0.3 }));\n        });\n    </script>\n</div>\n",
