      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Mulish:wght@400;500;600;700&display=swap');\n\n  :root {\n    --midnight-navy: #000080;\n    --goldenrod: #DAA520;\n    --bg-light: #F8FAFC;\n  }\n\n  body {\n    font-family: 'Mulish', sans-serif;\n    color: #1e293b;\n    background-color: var(--bg-light);\n    overflow-x: clip;\n  }\n\n  .font-heading {\n    font-family: 'Nunito', sans-serif;\n  }\n\n  .glass {\n    background: rgba(255, 255, 255, 0.15);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.25);\n  }\n\n  .bento-card-hover:hover {\n    transform: translateY(-8px);\n    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar {\n    width: 8px;\n  }\n  ::-webkit-scrollbar-track {\n    background: #f1f1f1;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: var(--midnight-navy);\n    border-radius: 10px;\n  }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" data-kid=\"2\">\n<div class=\"relative w-full overflow-x-clip\" data-kid=\"3\">\n  \n  <nav class=\"absolute top-0 left-0 right-0 z-50 flex justify-between items-center px-8 py-6 max-w-7xl mx-auto\" data-kid=\"4\">\n    <div class=\"flex items-center gap-2\" data-kid=\"5\">\n      <div class=\"w-10 h-10 bg-white rounded-xl flex items-center justify-center shadow-lg\" data-kid=\"6\">\n        <svg class=\"w-6 h-6 text-[var(--midnight-navy)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" data-kid=\"7\">\n          <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"8\"></path>\n        </svg>\n      </div>\n      <span class=\"font-heading text-2xl font-black text-white tracking-tight\" data-kid=\"9\">OnMove</span>\n    </div>\n    <div class=\"hidden md:flex gap-8 items-center\" data-kid=\"10\">\n      <a href=\"#\" class=\"text-white font-bold hover:text-[var(--goldenrod)] transition-colors\" data-kid=\"11\">How it works</a>\n      <a href=\"#\" class=\"text-white font-bold hover:text-[var(--goldenrod)] transition-colors\" data-kid=\"12\">Community</a>\n      <a href=\"#\" class=\"text-white font-bold hover:text-[var(--goldenrod)] transition-colors\" data-kid=\"13\">Safety</a>\n      <button class=\"bg-[var(--goldenrod)] text-[var(--midnight-navy)] px-6 py-2.5 rounded-xl font-bold shadow-lg hover:shadow-[var(--goldenrod)]/30 transition-all\" data-kid=\"14\">Join Us</button>\n    </div>\n    <button class=\"md:hidden text-white\" data-kid=\"15\">\n      <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"16\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\" data-kid=\"17\"></path></svg>\n    </button>\n  </nav>\n\n  \n  <header class=\"relative w-full h-screen min-h-[700px] overflow-hidden\" data-kid=\"18\">\n    <video src=\"https://player.vimeo.com/external/371427221.sd.mp4?s=340788d7f7a781079d71c4d9a42e5b7c89f2a404&profile_id=164&oauth2_token_id=57447761\" poster=\"https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=1280&q=80\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover scale-105\" data-kid=\"19\"></video>\n    <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--midnight-navy)]/80 to-transparent\" data-kid=\"20\"></div>\n    \n    <div class=\"relative z-10 h-full max-w-7xl mx-auto px-8 flex flex-col justify-center\" data-kid=\"21\">\n      <div class=\"glass max-w-xl p-10 md:p-12 rounded-3xl shadow-2xl hero-content\" data-kid=\"22\">\n        <h1 class=\"font-heading text-5xl md:text-6xl font-black text-white mb-6 leading-[1.1]\" data-kid=\"23\">\n          Move together, <br data-kid=\"24\"><span class=\"text-[var(--goldenrod)]\" data-kid=\"25\">Save together.</span>\n        </h1>\n        <p class=\"text-white/90 text-xl font-medium mb-10 leading-relaxed\" data-kid=\"26\">\n          The warmest community-driven ride sharing platform. Connect with neighbors, split costs, and reduce your footprint.\n        </p>\n        <div class=\"flex items-center gap-8\" data-kid=\"27\">\n          <button class=\"bg-[var(--goldenrod)] hover:bg-[#b88a1a] text-[var(--midnight-navy)] font-black px-10 py-5 rounded-2xl transition-all shadow-xl text-lg hover:scale-105 active:scale-95\" data-kid=\"28\">Find a ride</button>\n          <a href=\"#\" class=\"text-white font-bold text-lg hover:text-[var(--goldenrod)] flex items-center gap-2 group\" data-kid=\"29\">\n            Post a trip\n            <svg class=\"w-5 h-5 group-hover:translate-x-1 transition-transform\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"30\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" data-kid=\"31\"></path></svg>\n          </a>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"max-w-7xl mx-auto px-8 py-32\" data-kid=\"32\">\n    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8\" data-kid=\"33\">\n      \n      \n      <section class=\"bento-card bento-card-hover md:col-span-8 md:row-span-2 bg-white rounded-[2.5rem] p-12 flex flex-col justify-between relative overflow-hidden shadow-2xl shadow-slate-200 border border-slate-100 bento-group-reveal min-h-[500px]\" data-kid=\"34\">\n        <div class=\"relative z-10\" data-kid=\"35\">\n          <div class=\"w-12 h-1 bg-[var(--goldenrod)] mb-8\" data-kid=\"36\"></div>\n          <h2 class=\"font-heading text-4xl font-black text-[var(--midnight-navy)] mb-6\" data-kid=\"37\">What is OnMove?</h2>\n          <p class=\"text-slate-600 text-lg leading-relaxed max-w-md\" data-kid=\"38\">\n            OnMove is a community-driven ride sharing platform. We believe the best journeys are the ones shared with people heading your way. Split costs, share stories, and make every commute count.\n          </p>\n        </div>\n        <div class=\"relative z-10 flex gap-4 mt-8\" data-kid=\"39\">\n            <div class=\"flex -space-x-4\" data-kid=\"40\">\n              <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-12 h-12 rounded-full border-4 border-white\" alt=\"User\" data-kid=\"41\">\n              <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-12 h-12 rounded-full border-4 border-white\" alt=\"User\" data-kid=\"42\">\n              <img src=\"https://i.pravatar.cc/100?u=3\" class=\"w-12 h-12 rounded-full border-4 border-white\" alt=\"User\" data-kid=\"43\">\n              <div class=\"w-12 h-12 rounded-full border-4 border-white bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-400\" data-kid=\"44\">+2k</div>\n            </div>\n            <p class=\"text-sm font-bold text-slate-400 flex items-center\" data-kid=\"45\">Join 2,400+ members today</p>\n        </div>\n        <img src=\"https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&w=800&q=80&fit=crop\" class=\"absolute -bottom-20 -right-20 w-[450px] opacity-20 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\" alt=\"Community\" data-kid=\"46\">\n      </section>\n\n      \n      <section class=\"bento-card bento-card-hover md:col-span-4 bg-[var(--midnight-navy)] rounded-[2.5rem] p-12 flex flex-col justify-center relative overflow-hidden shadow-2xl bento-group-reveal\" data-kid=\"47\">\n        <div class=\"relative z-10\" data-kid=\"48\">\n          <h3 class=\"font-heading text-3xl font-extrabold text-white mb-4\" data-kid=\"49\">Find your ride</h3>\n          <p class=\"text-white/70 text-lg mb-8 max-w-sm\" data-kid=\"50\">\n            Browse available rides near you in real time. Find someone heading your way and join them in just a few taps.\n          </p>\n          <button class=\"bg-white/10 text-white border border-white/20 px-6 py-3 rounded-xl font-bold hover:bg-white hover:text-[var(--midnight-navy)] transition-all inline-flex items-center gap-2\" data-kid=\"51\">\n            Browse rides\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"52\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" data-kid=\"53\"></path></svg>\n          </button>\n        </div>\n        <div class=\"absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-white/5 to-transparent pointer-events-none\" data-kid=\"54\"></div>\n      </section>\n\n      \n      <section class=\"bento-card bento-card-hover md:col-span-2 bg-white rounded-[2rem] p-8 flex flex-col justify-between shadow-lg border border-slate-100 relative overflow-hidden bento-group-reveal min-h-[300px]\" data-kid=\"55\">\n        <div data-kid=\"56\">\n          <div class=\"w-12 h-12 bg-[var(--goldenrod)]/10 rounded-2xl flex items-center justify-center text-[var(--goldenrod)] mb-6 group-hover:scale-110 transition-transform\" data-kid=\"57\">\n            <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\" data-kid=\"58\"><path d=\"M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z\" data-kid=\"59\"></path></svg>\n          </div>\n          <h3 class=\"font-heading text-xl font-black text-[var(--midnight-navy)] mb-2\" data-kid=\"60\">Help others get there</h3>\n          <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"61\">\n            Post your route and let others join you. Share the journey, reduce costs.\n          </p>\n        </div>\n        <a href=\"#\" class=\"text-[var(--midnight-navy)] font-black text-sm hover:underline mt-4\" data-kid=\"62\">Post a ride →</a>\n      </section>\n\n      \n      <section class=\"bento-card bento-card-hover md:col-span-2 bg-[var(--goldenrod)] rounded-[2rem] p-8 flex flex-col justify-between shadow-lg relative bento-group-reveal min-h-[300px]\" data-kid=\"63\">\n        <div data-kid=\"64\">\n          <div class=\"w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center text-[var(--midnight-navy)] mb-6 group-hover:rotate-12 transition-transform\" data-kid=\"65\">\n            <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\" data-kid=\"66\"><path d=\"M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z\" data-kid=\"67\"></path></svg>\n          </div>\n          <h3 class=\"font-heading text-xl font-black text-[var(--midnight-navy)] mb-2\" data-kid=\"68\">Connect with others</h3>\n          <p class=\"text-[var(--midnight-navy)]/70 text-sm leading-relaxed\" data-kid=\"69\">\n            Build real connections in your community. Every ride is an opportunity.\n          </p>\n        </div>\n        <img src=\"https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&w=400&q=80&fit=crop\" class=\"absolute -bottom-8 -right-8 w-32 h-32 rounded-full border-4 border-white shadow-xl opacity-50 group-hover:opacity-100 transition-opacity\" alt=\"Smiling People\" data-kid=\"70\">\n      </section>\n    </div>\n  </main>\n\n  \n  <section class=\"bg-white py-24\" data-kid=\"71\">\n    <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"72\">\n      <div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-8\" data-kid=\"73\">\n        <div class=\"max-w-2xl\" data-kid=\"74\">\n          <h2 class=\"font-heading text-4xl font-black text-[var(--midnight-navy)] mb-6\" data-kid=\"75\">Designed for people, powered by trust</h2>\n          <p class=\"text-slate-600 text-lg\" data-kid=\"76\">We've reimagined ride-sharing by focusing on what truly matters: safety, friendship, and the joy of shared experiences.</p>\n        </div>\n        <div class=\"flex gap-4\" data-kid=\"77\">\n          <div class=\"p-8 bg-slate-50 rounded-3xl border border-slate-100 text-center shadow-xs\" data-kid=\"78\">\n            <p class=\"text-4xl font-black text-[var(--midnight-navy)]\" data-kid=\"79\">98%</p>\n            <p class=\"text-xs text-slate-600 font-black uppercase tracking-widest mt-2\" data-kid=\"80\">Trust Score</p>\n          </div>\n          <div class=\"p-8 bg-slate-50 rounded-3xl border border-slate-100 text-center shadow-xs\" data-kid=\"81\">\n            <p class=\"text-4xl font-black text-[var(--midnight-navy)]\" data-kid=\"82\">4.9/5</p>\n            <p class=\"text-xs text-slate-600 font-black uppercase tracking-widest mt-2\" data-kid=\"83\">Member Rating</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch\" data-kid=\"84\">\n        <div class=\"md:col-span-7\" data-kid=\"85\">\n          <div class=\"bg-slate-50 rounded-[3rem] overflow-hidden group h-full relative\" data-kid=\"86\">\n            <img src=\"https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000\" alt=\"Coworking\" data-kid=\"87\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--midnight-navy)]/80 via-transparent to-transparent\" data-kid=\"88\"></div>\n            <div class=\"absolute bottom-0 left-0 p-12 text-white\" data-kid=\"89\">\n              <h4 class=\"font-heading text-3xl font-bold mb-4\" data-kid=\"90\">Fair Cost Sharing</h4>\n              <p class=\"text-white/80 text-lg max-w-md\" data-kid=\"91\">No hidden fees. Split gas and tolls naturally using our smart cost calculator. It's fair travel for a fairer world.</p>\n            </div>\n          </div>\n        </div>\n        <div class=\"md:col-span-5 flex flex-col gap-8\" data-kid=\"92\">\n          <div class=\"bg-slate-50 rounded-[2.5rem] p-10 flex flex-col gap-6 group hover:bg-slate-100 transition-colors\" data-kid=\"93\">\n            <div class=\"w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[var(--midnight-navy)] shadow-sm\" data-kid=\"94\">\n                <i class=\"fa-solid fa-shield-halved text-2xl\" data-kid=\"95\"></i>\n            </div>\n            <div data-kid=\"96\">\n                <h4 class=\"font-heading text-2xl font-bold text-[var(--midnight-navy)] mb-3\" data-kid=\"97\">Verified Profiles</h4>\n                <p class=\"text-slate-500 leading-relaxed\" data-kid=\"98\">Every member is manually verified through our trust network to ensure your safety and comfort.</p>\n            </div>\n          </div>\n          <div class=\"bg-[var(--goldenrod)]/5 rounded-[2.5rem] p-10 flex flex-col gap-6 group hover:bg-[var(--goldenrod)]/10 transition-colors\" data-kid=\"99\">\n            <div class=\"w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[var(--goldenrod)] shadow-sm\" data-kid=\"100\">\n                <i class=\"fa-solid fa-leaf text-2xl\" data-kid=\"101\"></i>\n            </div>\n            <div data-kid=\"102\">\n                <h4 class=\"font-heading text-2xl font-bold text-[var(--midnight-navy)] mb-3\" data-kid=\"103\">Eco-Friendly</h4>\n                <p class=\"text-slate-500 leading-relaxed\" data-kid=\"104\">Help reduce traffic and CO2 emissions. One shared ride removes one car from the road every day.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24 max-w-7xl mx-auto px-8\" data-kid=\"105\">\n    <div class=\"bg-white rounded-[4rem] overflow-hidden flex flex-col md:flex-row items-center shadow-2xl shadow-slate-200 border border-slate-100\" data-kid=\"106\">\n      <div class=\"p-16 md:w-3/5 text-left\" data-kid=\"107\">\n        <span class=\"inline-block bg-[var(--goldenrod)]/10 text-[var(--goldenrod)] px-4 py-1.5 rounded-full text-sm font-black uppercase tracking-widest mb-6\" data-kid=\"108\">Join the movement</span>\n        <h2 class=\"font-heading text-5xl font-black text-[var(--midnight-navy)] mb-6 leading-tight\" data-kid=\"109\">Ready to find your <br data-kid=\"110\">next travel companion?</h2>\n        <p class=\"text-slate-500 text-xl max-w-lg mb-10 leading-relaxed\" data-kid=\"111\">Sign up in seconds and join a community that values connection as much as the destination. Friendly, fast, and always free.</p>\n        <button class=\"bg-[var(--midnight-navy)] text-white px-12 py-5 rounded-2xl font-black text-xl hover:bg-slate-900 transition-all shadow-xl hover:scale-105 active:scale-95\" data-kid=\"112\">Create Account</button>\n      </div>\n      <div class=\"md:w-2/5 h-full min-h-[500px] relative\" data-kid=\"113\">\n        <img src=\"https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&w=800&q=80&fit=crop\" class=\"absolute inset-0 w-full h-full object-cover\" alt=\"Happy Community\" data-kid=\"114\">\n        <div class=\"absolute inset-0 bg-gradient-to-r from-white via-transparent to-transparent\" data-kid=\"115\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-white border-t border-slate-100 pt-20 pb-10\" data-kid=\"116\">\n    <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"117\">\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-20\" data-kid=\"118\">\n        <div class=\"col-span-1 md:col-span-1\" data-kid=\"119\">\n          <div class=\"flex items-center gap-2 mb-6\" data-kid=\"120\">\n            <div class=\"w-8 h-8 bg-[var(--midnight-navy)] rounded-lg flex items-center justify-center\" data-kid=\"121\">\n              <svg class=\"w-4 h-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" data-kid=\"122\">\n                <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"123\"></path>\n              </svg>\n            </div>\n            <span class=\"font-heading text-xl font-black text-[var(--midnight-navy)] tracking-tight\" data-kid=\"124\">OnMove</span>\n          </div>\n          <p class=\"text-slate-500 leading-relaxed mb-6\" data-kid=\"125\">Changing the way we travel, one shared ride at a time.</p>\n          <div class=\"flex gap-4\" data-kid=\"126\">\n            <a href=\"#\" aria-label=\"Twitter\" class=\"w-11 h-11 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-400 hover:text-[var(--midnight-navy)] hover:bg-white hover:shadow-md transition-all\" data-kid=\"127\">\n              <i class=\"fa-brands fa-x-twitter text-xl\" data-kid=\"128\"></i>\n            </a>\n            <a href=\"#\" aria-label=\"Facebook\" class=\"w-11 h-11 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-400 hover:text-[var(--midnight-navy)] hover:bg-white hover:shadow-md transition-all\" data-kid=\"129\">\n              <i class=\"fa-brands fa-facebook-f text-xl\" data-kid=\"130\"></i>\n            </a>\n            <a href=\"#\" aria-label=\"Instagram\" class=\"w-11 h-11 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-400 hover:text-[var(--midnight-navy)] hover:bg-white hover:shadow-md transition-all\" data-kid=\"131\">\n              <i class=\"fa-brands fa-instagram text-xl\" data-kid=\"132\"></i>\n            </a>\n          </div>\n        </div>\n        <div data-kid=\"133\">\n          <h5 class=\"font-heading font-black text-[var(--midnight-navy)] mb-6 uppercase tracking-widest text-sm\" data-kid=\"134\">Product</h5>\n          <ul class=\"space-y-4 text-slate-500 font-medium\" data-kid=\"135\">\n            <li data-kid=\"136\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"137\">Find a Ride</a></li>\n            <li data-kid=\"138\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"139\">Offer a Trip</a></li>\n            <li data-kid=\"140\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"141\">Route Planner</a></li>\n            <li data-kid=\"142\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"143\">Safety Guide</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"144\">\n          <h5 class=\"font-heading font-black text-[var(--midnight-navy)] mb-6 uppercase tracking-widest text-sm\" data-kid=\"145\">Company</h5>\n          <ul class=\"space-y-4 text-slate-500 font-medium\" data-kid=\"146\">\n            <li data-kid=\"147\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"148\">About Us</a></li>\n            <li data-kid=\"149\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"150\">Our Community</a></li>\n            <li data-kid=\"151\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"152\">Careers</a></li>\n            <li data-kid=\"153\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"154\">Impact Report</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"155\">\n          <h5 class=\"font-heading font-black text-[var(--midnight-navy)] mb-6 uppercase tracking-widest text-sm\" data-kid=\"156\">Support</h5>\n          <ul class=\"space-y-4 text-slate-500 font-medium\" data-kid=\"157\">\n            <li data-kid=\"158\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"159\">Help Center</a></li>\n            <li data-kid=\"160\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"161\">Contact Us</a></li>\n            <li data-kid=\"162\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"163\">Terms of Service</a></li>\n            <li data-kid=\"164\"><a href=\"#\" class=\"hover:text-[var(--midnight-navy)] transition-colors\" data-kid=\"165\">Privacy Policy</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"pt-10 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-400 text-sm font-bold\" data-kid=\"166\">\n        <p data-kid=\"167\">&copy; 2026 OnMove Inc. All rights reserved.</p>\n        <div class=\"flex gap-8\" data-kid=\"168\">\n          <a href=\"#\" class=\"hover:text-[var(--midnight-navy)]\" data-kid=\"169\">Privacy</a>\n          <a href=\"#\" class=\"hover:text-[var(--midnight-navy)]\" data-kid=\"170\">Cookies</a>\n          <a href=\"#\" class=\"hover:text-[var(--midnight-navy)]\" data-kid=\"171\">Accessibility</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"172\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"173\"></script>\n<script type=\"module\" data-kid=\"174\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Initialize Lenis\n  const lenis = new Lenis();\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  // Register GSAP Plugins\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Animations\n  gsap.from(\".hero-content\", {\n    y: 50,\n    opacity: 0,\n    duration: 1.2,\n    ease: \"power4.out\",\n    delay: 0.2\n  });\n\n  gsap.from(\".bento-group-reveal\", {\n    y: 80,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.15,\n    ease: \"power3.out\",\n    scrollTrigger: {\n      trigger: \"main\",\n      start: \"top 80%\",\n    }\n  });\n\n  gsap.utils.toArray(\".group\").forEach(section => {\n    gsap.from(section, {\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      scrollTrigger: {\n        trigger: section,\n        start: \"top 90%\",\n      }\n    });\n  });\n</script>\n",
