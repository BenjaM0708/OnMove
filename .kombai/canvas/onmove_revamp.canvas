      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Mulish:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-navy: #000080;\n    --color-gold: #DAA520;\n    --color-camel: #C19A6B;\n    --color-bg-light: #F8FAFC;\n  }\n\n  body {\n    font-family: 'Mulish', sans-serif;\n    background-color: var(--color-bg-light);\n    color: #1E293B;\n    margin: 0;\n  }\n\n  .font-heading {\n    font-family: 'Nunito', sans-serif;\n  }\n\n  .glass-card {\n    background: rgba(0, 0, 128, 0.85);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .bento-card {\n    background: white;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n\n  .bento-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"absolute top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-6 max-w-7xl mx-auto\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-(--color-gold) rounded-xl flex items-center justify-center shadow-lg\" data-kid=\"4\">\n         <i class=\"ti ti-car text-white text-xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-heading text-2xl font-extrabold text-white tracking-tight\" data-kid=\"6\">OnMove</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-8 text-white/90 font-semibold\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-(--color-gold) transition-colors\" data-kid=\"8\">How it works</a>\n      <a href=\"#\" class=\"hover:text-(--color-gold) transition-colors\" data-kid=\"9\">Safety</a>\n      <a href=\"#\" class=\"hover:text-(--color-gold) transition-colors\" data-kid=\"10\">Support</a>\n      <button class=\"bg-(--color-gold) text-white px-6 py-2.5 rounded-xl hover:brightness-110 transition-all shadow-lg font-bold\" data-kid=\"11\">\n        Get Started\n      </button>\n    </div>\n  </nav>\n\n  \n  <header class=\"relative h-[90vh] flex items-center justify-center overflow-hidden\" data-kid=\"12\">\n    <img src=\"https://images.pexels.com/photos/7464537/pexels-photo-7464537.jpeg?auto=compress&cs=tinysrgb&w=1920&q=80\" alt=\"Happy friends carpooling\" class=\"absolute inset-0 w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"13\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-(--color-bg-light)\" data-kid=\"14\"></div>\n    \n    <div class=\"relative z-10 max-w-4xl px-6 text-center\" data-kid=\"15\">\n      <div class=\"glass-card p-10 md:p-16 rounded-[2.5rem] shadow-2xl border border-white/10\" data-kid=\"16\">\n        <h1 class=\"font-heading text-4xl md:text-7xl font-extrabold text-white leading-[1.1] mb-6\" data-kid=\"17\">\n          Move together, <span class=\"text-(--color-gold)\" data-kid=\"18\">Save</span> together.\n        </h1>\n        <p class=\"text-white/80 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-10\" data-kid=\"19\">\n          Join a community of 50,000+ commuters sharing rides, reducing costs, and making every journey count. Fast, simple, and always free.\n        </p>\n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\" data-kid=\"20\">\n          <button class=\"w-full sm:w-auto bg-(--color-gold) text-white px-10 py-4 rounded-2xl font-bold text-lg shadow-xl hover:scale-105 transition-transform\" data-kid=\"21\">\n            Find a Ride\n          </button>\n          <button class=\"w-full sm:w-auto bg-white/10 backdrop-blur-md text-white border border-white/20 px-10 py-4 rounded-2xl font-bold text-lg hover:bg-white/20 transition-all\" data-kid=\"22\">\n            Post a Route\n          </button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"max-w-7xl mx-auto px-6 py-24\" data-kid=\"23\">\n    <div class=\"text-center mb-16\" data-kid=\"24\">\n      <h2 class=\"font-heading text-3xl md:text-5xl font-extrabold text-(--color-navy) mb-4\" data-kid=\"25\">Why OnMove?</h2>\n      <p class=\"text-slate-500 text-lg max-w-2xl mx-auto\" data-kid=\"26\">The smarter way to travel, built for the community by the community.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-6 grid-rows-2 gap-6 h-auto md:h-[700px]\" data-kid=\"27\">\n      \n      <div class=\"md:col-span-4 md:row-span-2 bento-card rounded-3xl overflow-hidden shadow-sm flex flex-col\" data-kid=\"28\">\n        <div class=\"p-8 md:p-12\" data-kid=\"29\">\n          <div class=\"w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 text-(--color-navy)\" data-kid=\"30\">\n            <i class=\"ti ti-map-pin-filled text-3xl\" data-kid=\"31\"></i>\n          </div>\n          <h3 class=\"font-heading text-3xl font-bold text-(--color-navy) mb-4\" data-kid=\"32\">Find your next ride</h3>\n          <p class=\"text-slate-600 text-lg mb-8 max-w-md\" data-kid=\"33\">Browse real-time rides near you. From daily commutes to weekend trips, connect with drivers heading your way instantly.</p>\n          <button class=\"text-(--color-gold) font-extrabold flex items-center gap-2 group\" data-kid=\"34\">\n            Browse active rides <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"35\"></i>\n          </button>\n        </div>\n        <div class=\"mt-auto pl-8 pb-0\" data-kid=\"36\">\n          <img src=\"https://images.unsplash.com/photo-1629366961667-6c232190f6f7?auto=format&w=800&q=80&fit=crop\" alt=\"Navigation UI\" class=\"rounded-tl-3xl shadow-2xl border-l border-t border-slate-100\" decoding=\"async\" loading=\"lazy\" data-kid=\"37\">\n        </div>\n      </div>\n\n      \n      <div class=\"md:col-span-2 md:row-span-1 bento-card bg-(--color-navy) text-white rounded-3xl p-8 shadow-sm\" data-kid=\"38\">\n        <div class=\"w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mb-6 text-(--color-gold)\" data-kid=\"39\">\n          <i class=\"ti ti-wallet text-2xl\" data-kid=\"40\"></i>\n        </div>\n        <h3 class=\"font-heading text-2xl font-bold mb-3\" data-kid=\"41\">Travel for free</h3>\n        <p class=\"text-white/70\" data-kid=\"42\">No fees, no subscriptions. Split costs naturally with people going your way.</p>\n      </div>\n\n      \n      <div class=\"md:col-span-2 md:row-span-1 bento-card bg-white rounded-3xl p-8 shadow-sm border border-slate-100\" data-kid=\"43\">\n        <div class=\"w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mb-6 text-(--color-gold)\" data-kid=\"44\">\n          <i class=\"ti ti-heart-handshake text-2xl\" data-kid=\"45\"></i>\n        </div>\n        <h3 class=\"font-heading text-2xl font-bold text-(--color-navy) mb-3\" data-kid=\"46\">Connect with others</h3>\n        <p class=\"text-slate-500\" data-kid=\"47\">Build real connections in your community. Every ride is a new opportunity.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"max-w-7xl mx-auto px-6 pb-24\" data-kid=\"48\">\n    <div class=\"bg-(--color-gold) rounded-[3rem] p-12 md:p-20 text-center relative overflow-hidden\" data-kid=\"49\">\n      <div class=\"absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2\" data-kid=\"50\"></div>\n      <div class=\"relative z-10\" data-kid=\"51\">\n        <h2 class=\"font-heading text-4xl md:text-6xl font-extrabold text-white mb-6\" data-kid=\"52\">Help others get there.</h2>\n        <p class=\"text-white/90 text-xl max-w-2xl mx-auto mb-10 font-medium\" data-kid=\"53\">\n          Post your route and let others join you. Share the journey, reduce costs, and make a difference.\n        </p>\n        <button class=\"bg-white text-(--color-navy) px-12 py-5 rounded-2xl font-extrabold text-xl shadow-2xl hover:bg-slate-50 transition-colors\" data-kid=\"54\">\n          Become a Driver\n        </button>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-(--color-navy) text-white py-20 px-6\" data-kid=\"55\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"56\">\n      <div class=\"md:col-span-2\" data-kid=\"57\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"58\">\n          <div class=\"w-8 h-8 bg-(--color-gold) rounded-lg flex items-center justify-center\" data-kid=\"59\">\n            <i class=\"ti ti-car text-white\" data-kid=\"60\"></i>\n          </div>\n          <span class=\"font-heading text-2xl font-bold\" data-kid=\"61\">OnMove</span>\n        </div>\n        <p class=\"text-white/60 max-w-xs mb-8\" data-kid=\"62\">Redefining the daily commute through community-driven ride sharing.</p>\n        <div class=\"flex gap-4\" data-kid=\"63\">\n          <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors\" data-kid=\"64\"><i class=\"ti ti-brand-twitter\" data-kid=\"65\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors\" data-kid=\"66\"><i class=\"ti ti-brand-instagram\" data-kid=\"67\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors\" data-kid=\"68\"><i class=\"ti ti-brand-linkedin\" data-kid=\"69\"></i></a>\n        </div>\n      </div>\n      <div data-kid=\"70\">\n        <h4 class=\"font-heading font-bold mb-6\" data-kid=\"71\">Product</h4>\n        <ul class=\"space-y-4 text-white/60\" data-kid=\"72\">\n          <li data-kid=\"73\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"74\">Find a ride</a></li>\n          <li data-kid=\"75\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"76\">Post a ride</a></li>\n          <li data-kid=\"77\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"78\">Safety center</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"79\">\n        <h4 class=\"font-heading font-bold mb-6\" data-kid=\"80\">Company</h4>\n        <ul class=\"space-y-4 text-white/60\" data-kid=\"81\">\n          <li data-kid=\"82\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"83\">About us</a></li>\n          <li data-kid=\"84\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"85\">Privacy Policy</a></li>\n          <li data-kid=\"86\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"87\">Terms of Service</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto border-t border-white/10 mt-16 pt-8 text-center text-white/40 text-sm\" data-kid=\"88\">\n      &copy; 2026 OnMove Inc. All rights reserved.\n    </div>\n  </footer>\n</div>",
      "comments": [],
