      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --brand-navy: #00009C;\n    --brand-gold: #FFC40C;\n    --brand-dark: #00004F;\n    --ghost-white: #F8FAFC;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    padding: 0;\n    background-color: var(--brand-navy);\n    color: white;\n  }\n\n  .font-display {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .text-gold {\n    color: var(--brand-gold);\n  }\n\n  .bg-gold {\n    background-color: var(--brand-gold);\n  }\n\n  .border-gold {\n    border-color: var(--brand-gold);\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(10px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .grid-asymmetric {\n    display: grid;\n    grid-template-columns: 1.5fr 1fr;\n    gap: 2rem;\n  }\n\n  @media (max-width: 768px) {\n    .grid-asymmetric {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 z-50 px-6 py-4 flex items-center justify-between glass-card border-x-0 border-t-0\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-8 h-8 rounded-xs bg-gold flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-car text-brand-navy text-xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-display font-bold text-xl tracking-tight\" data-kid=\"6\">OnMove</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-8 text-sm font-medium\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-gold transition-colors\" data-kid=\"8\">How it works</a>\n      <a href=\"#\" class=\"hover:text-gold transition-colors\" data-kid=\"9\">Find a ride</a>\n      <a href=\"#\" class=\"hover:text-gold transition-colors\" data-kid=\"10\">Drivers</a>\n    </div>\n    <button class=\"bg-gold text-brand-dark px-5 py-2 rounded-xs font-display font-bold text-xs uppercase tracking-widest hover:bg-white transition-all\" data-kid=\"11\">\n      Sign In\n    </button>\n  </nav>\n\n  \n  <header class=\"relative overflow-hidden px-6 pt-20 pb-32\" data-kid=\"12\">\n    <div class=\"max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-center\" data-kid=\"13\">\n      <div class=\"lg:col-span-6 z-10\" data-kid=\"14\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full border border-gold/30 bg-gold/10 text-gold text-xs font-bold uppercase tracking-widest mb-6\" data-kid=\"15\">\n          <span class=\"relative flex h-2 w-2\" data-kid=\"16\">\n            <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-gold opacity-75\" data-kid=\"17\"></span>\n            <span class=\"relative inline-flex rounded-full h-2 w-2 bg-gold\" data-kid=\"18\"></span>\n          </span>\n          Live in Madrid & Beyond\n        </div>\n        <h1 class=\"font-display text-6xl md:text-8xl font-bold leading-[0.9] tracking-tighter mb-8\" data-kid=\"19\">\n          Move <span class=\"text-gold\" data-kid=\"20\">together</span>.<br data-kid=\"21\">Save <span class=\"text-gold\" data-kid=\"22\">together</span>.\n        </h1>\n        <p class=\"text-white/60 text-lg md:text-xl max-w-lg mb-10 leading-relaxed\" data-kid=\"23\">\n          The high-efficiency carpooling network. Share your commute, split the costs, and reach your destination faster with real-time matching.\n        </p>\n        <div class=\"flex flex-col sm:flex-row gap-4\" data-kid=\"24\">\n          <button class=\"bg-gold text-brand-dark px-8 py-4 rounded-xs font-display font-bold text-sm uppercase tracking-widest flex items-center justify-center gap-2 hover:translate-y-[-2px] transition-all\" data-kid=\"25\">\n            Browse Available Rides <i class=\"ti ti-arrow-up-right\" data-kid=\"26\"></i>\n          </button>\n          <button class=\"border border-white/20 text-white px-8 py-4 rounded-xs font-display font-bold text-sm uppercase tracking-widest hover:bg-white/10 transition-all\" data-kid=\"27\">\n            Post Your Route\n          </button>\n        </div>\n      </div>\n      \n      \n      <div class=\"lg:col-span-6 relative\" data-kid=\"28\">\n        <div class=\"relative z-10 glass-card p-4 rounded-xs shadow-2xl overflow-hidden border-white/20\" data-kid=\"29\">\n          <div class=\"aspect-[4/3] rounded-xs bg-[#0F172A] overflow-hidden relative\" data-kid=\"30\">\n            <img src=\"https://images.unsplash.com/photo-1701711995517-c992ace5fe93?auto=format&w=800&q=80&fit=crop\" alt=\"GPS Route\" class=\"w-full h-full object-cover opacity-60 grayscale hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"31\">\n            \n            <div class=\"absolute top-4 left-4 right-4 flex justify-between gap-4\" data-kid=\"32\">\n              <div class=\"bg-brand-dark/90 backdrop-blur-md p-3 rounded-xs border border-white/10 flex-1\" data-kid=\"33\">\n                <p class=\"text-[10px] text-white/40 uppercase tracking-widest mb-1\" data-kid=\"34\">Destination</p>\n                <p class=\"text-xs font-bold\" data-kid=\"35\">Calle Mayor, 1, Madrid</p>\n              </div>\n              <div class=\"bg-brand-dark/90 backdrop-blur-md p-3 rounded-xs border border-gold/30\" data-kid=\"36\">\n                <i class=\"ti ti-navigation text-gold\" data-kid=\"37\"></i>\n              </div>\n            </div>\n            \n            <div class=\"absolute bottom-4 left-4 right-4\" data-kid=\"38\">\n              <div class=\"bg-brand-dark/90 backdrop-blur-md p-4 rounded-xs border border-white/10\" data-kid=\"39\">\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"40\">\n                  <div class=\"flex items-center gap-2\" data-kid=\"41\">\n                    <img src=\"https://i.pravatar.cc/40?u=driver1\" alt=\"Driver\" class=\"w-8 h-8 rounded-full border border-gold\" decoding=\"async\" loading=\"lazy\" data-kid=\"42\">\n                    <div data-kid=\"43\">\n                      <p class=\"text-xs font-bold\" data-kid=\"44\">Carlos R.</p>\n                      <p class=\"text-[10px] text-white/40\" data-kid=\"45\">4.9 ★ (128 rides)</p>\n                    </div>\n                  </div>\n                  <div class=\"text-right\" data-kid=\"46\">\n                    <p class=\"text-gold font-bold\" data-kid=\"47\">€4.50</p>\n                    <p class=\"text-[10px] text-white/40\" data-kid=\"48\">Per Seat</p>\n                  </div>\n                </div>\n                <button class=\"w-full bg-gold text-brand-dark py-2 rounded-xs text-[10px] font-bold uppercase tracking-widest\" data-kid=\"49\">Join Ride</button>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-gold/20 blur-[100px] rounded-full\" data-kid=\"50\"></div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"border-y border-white/10 bg-brand-dark/30\" data-kid=\"51\">\n    <div class=\"max-w-7xl mx-auto px-6 py-12 grid grid-cols-2 md:grid-cols-4 gap-8\" data-kid=\"52\">\n      <div class=\"text-center\" data-kid=\"53\">\n        <p class=\"font-display text-4xl font-bold mb-1\" data-kid=\"54\">12K+</p>\n        <p class=\"text-white/40 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"55\">Active Users</p>\n      </div>\n      <div class=\"text-center\" data-kid=\"56\">\n        <p class=\"font-display text-4xl font-bold mb-1\" data-kid=\"57\">450</p>\n        <p class=\"text-white/40 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"58\">Daily Rides</p>\n      </div>\n      <div class=\"text-center\" data-kid=\"59\">\n        <p class=\"font-display text-4xl font-bold mb-1\" data-kid=\"60\">2.4T</p>\n        <p class=\"text-white/40 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"61\">CO2 Saved</p>\n      </div>\n      <div class=\"text-center\" data-kid=\"62\">\n        <p class=\"font-display text-4xl font-bold mb-1\" data-kid=\"63\">€850</p>\n        <p class=\"text-white/40 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"64\">Avg Monthly Saving</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-6\" data-kid=\"65\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"66\">\n      <div class=\"grid lg:grid-cols-12 gap-12 items-center mb-32\" data-kid=\"67\">\n        <div class=\"lg:col-span-7\" data-kid=\"68\">\n          <div class=\"relative rounded-xs overflow-hidden border border-white/10\" data-kid=\"69\">\n            <img src=\"https://images.unsplash.com/photo-1610913721979-b20ede600e63?auto=format&w=1200&q=80&fit=crop\" alt=\"Tech Dashboard\" class=\"w-full h-[500px] object-cover grayscale brightness-50\" decoding=\"async\" loading=\"lazy\" data-kid=\"70\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-brand-navy via-transparent to-transparent\" data-kid=\"71\"></div>\n          </div>\n        </div>\n        <div class=\"lg:col-span-5\" data-kid=\"72\">\n          <h2 class=\"font-display text-4xl md:text-5xl font-bold mb-6 leading-tight\" data-kid=\"73\">\n            The infrastructure of <span class=\"text-gold\" data-kid=\"74\">modern transit</span>.\n          </h2>\n          <p class=\"text-white/60 mb-8 leading-relaxed\" data-kid=\"75\">\n            OnMove isn't just an app—it's a decentralized transport layer. We connect thousands of empty seats with travelers in real-time, reducing congestion and individual costs.\n          </p>\n          <ul class=\"space-y-4 mb-10\" data-kid=\"76\">\n            <li class=\"flex items-start gap-3\" data-kid=\"77\">\n              <i class=\"ti ti-check text-gold mt-1\" data-kid=\"78\"></i>\n              <p class=\"text-sm font-medium\" data-kid=\"79\">Precision matching based on GPS route proximity.</p>\n            </li>\n            <li class=\"flex items-start gap-3\" data-kid=\"80\">\n              <i class=\"ti ti-check text-gold mt-1\" data-kid=\"81\"></i>\n              <p class=\"text-sm font-medium\" data-kid=\"82\">Verified profile system for secure community sharing.</p>\n            </li>\n            <li class=\"flex items-start gap-3\" data-kid=\"83\">\n              <i class=\"ti ti-check text-gold mt-1\" data-kid=\"84\"></i>\n              <p class=\"text-sm font-medium\" data-kid=\"85\">Automated cost splitting with zero platform fees.</p>\n            </li>\n          </ul>\n        </div>\n      </div>\n\n      \n      <div class=\"grid lg:grid-cols-12 gap-12 items-center\" data-kid=\"86\">\n        <div class=\"lg:col-span-5 order-2 lg:order-1\" data-kid=\"87\">\n          <h2 class=\"font-display text-4xl md:text-5xl font-bold mb-6 leading-tight\" data-kid=\"88\">\n            Find your ride <span class=\"text-gold\" data-kid=\"89\">instantly</span>.\n          </h2>\n          <p class=\"text-white/60 mb-8 leading-relaxed\" data-kid=\"90\">\n            Whether it's a cross-city commute or a weekend getaway, our algorithm finds the most efficient connection for you in seconds.\n          </p>\n          <button class=\"bg-white/5 border border-white/10 hover:border-gold/50 text-white px-8 py-4 rounded-xs font-display font-bold text-sm uppercase tracking-widest transition-all\" data-kid=\"91\">\n            Explore The Network\n          </button>\n        </div>\n        <div class=\"lg:col-span-7 order-1 lg:order-2\" data-kid=\"92\">\n          <div class=\"relative rounded-xs overflow-hidden border border-white/10\" data-kid=\"93\">\n            <img src=\"https://images.unsplash.com/photo-1622994834362-8d7bbd601476?auto=format&w=1200&q=80&fit=crop\" alt=\"Night Drive\" class=\"w-full h-[500px] object-cover grayscale brightness-50\" decoding=\"async\" loading=\"lazy\" data-kid=\"94\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-brand-navy via-transparent to-transparent\" data-kid=\"95\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"bg-brand-dark py-32 px-6\" data-kid=\"96\">\n    <div class=\"max-w-7xl mx-auto text-center mb-20\" data-kid=\"97\">\n      <h2 class=\"font-display text-5xl font-bold mb-4\" data-kid=\"98\">Engineered for <span class=\"text-gold\" data-kid=\"99\">Connection</span>.</h2>\n      <p class=\"text-white/40 max-w-2xl mx-auto\" data-kid=\"100\">Stripping away the friction of traditional carpooling with high-tech infrastructure.</p>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto grid md:grid-cols-3 gap-6\" data-kid=\"101\">\n      <div class=\"glass-card p-10 rounded-xs border-white/10 hover:border-gold/30 transition-all group\" data-kid=\"102\">\n        <i class=\"ti ti-map-bolt text-4xl text-gold mb-6 block transition-transform group-hover:scale-110\" data-kid=\"103\"></i>\n        <h3 class=\"font-display text-xl font-bold mb-4\" data-kid=\"104\">Real-time Routing</h3>\n        <p class=\"text-sm text-white/50 leading-relaxed\" data-kid=\"105\">Advanced mapping technology that calculates pick-up points with zero detour time for the driver.</p>\n      </div>\n      \n      <div class=\"glass-card p-10 rounded-xs border-white/10 hover:border-gold/30 transition-all group\" data-kid=\"106\">\n        <i class=\"ti ti-users-group text-4xl text-gold mb-6 block transition-transform group-hover:scale-110\" data-kid=\"107\"></i>\n        <h3 class=\"font-display text-xl font-bold mb-4\" data-kid=\"108\">Trust Infrastructure</h3>\n        <p class=\"text-sm text-white/50 leading-relaxed\" data-kid=\"109\">Multi-layered verification including government IDs and community ratings for every member.</p>\n      </div>\n      \n      <div class=\"glass-card p-10 rounded-xs border-white/10 hover:border-gold/30 transition-all group\" data-kid=\"110\">\n        <i class=\"ti ti-navigation text-4xl text-gold mb-6 block transition-transform group-hover:scale-110\" data-kid=\"111\"></i>\n        <h3 class=\"font-display text-xl font-bold mb-4\" data-kid=\"112\">Infinite Scalability</h3>\n        <p class=\"text-sm text-white/50 leading-relaxed\" data-kid=\"113\">A growing network of drivers across Spain, ensuring you can find a seat anytime, anywhere.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-6 text-center\" data-kid=\"114\">\n    <div class=\"max-w-4xl mx-auto border-2 border-gold p-20 rounded-xs relative overflow-hidden\" data-kid=\"115\">\n      <div class=\"relative z-10\" data-kid=\"116\">\n        <h2 class=\"font-display text-5xl md:text-7xl font-bold mb-8\" data-kid=\"117\">Ready to <span class=\"text-gold\" data-kid=\"118\">optimize</span> your commute?</h2>\n        <button class=\"bg-gold text-brand-dark px-12 py-5 rounded-xs font-display font-bold text-lg uppercase tracking-widest hover:bg-white transition-all\" data-kid=\"119\">\n          Join OnMove Now\n        </button>\n      </div>\n      \n      <div class=\"absolute inset-0 opacity-10 pointer-events-none\" style=\"background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;\" data-kid=\"120\"></div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-brand-dark/50 py-20 px-6 border-t border-white/10\" data-kid=\"121\">\n    <div class=\"max-w-7xl mx-auto grid md:grid-cols-4 gap-12\" data-kid=\"122\">\n      <div class=\"md:col-span-2\" data-kid=\"123\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"124\">\n          <div class=\"w-8 h-8 rounded-xs bg-gold flex items-center justify-center\" data-kid=\"125\">\n            <i class=\"ti ti-car text-brand-navy text-xl\" data-kid=\"126\"></i>\n          </div>\n          <span class=\"font-display font-bold text-xl tracking-tight\" data-kid=\"127\">OnMove</span>\n        </div>\n        <p class=\"text-white/40 max-w-sm mb-8\" data-kid=\"128\">\n          Optimizing human movement through community-driven carpooling. Join the network and change the way you travel.\n        </p>\n      </div>\n      <div data-kid=\"129\">\n        <h4 class=\"font-display font-bold mb-6 text-xs uppercase tracking-widest text-gold\" data-kid=\"130\">Platform</h4>\n        <ul class=\"space-y-4 text-sm text-white/60\" data-kid=\"131\">\n          <li data-kid=\"132\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"133\">Find Rides</a></li>\n          <li data-kid=\"134\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"135\">Post Routes</a></li>\n          <li data-kid=\"136\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"137\">Safety</a></li>\n          <li data-kid=\"138\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"139\">Pricing</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"140\">\n        <h4 class=\"font-display font-bold mb-6 text-xs uppercase tracking-widest text-gold\" data-kid=\"141\">Company</h4>\n        <ul class=\"space-y-4 text-sm text-white/60\" data-kid=\"142\">\n          <li data-kid=\"143\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"144\">About</a></li>\n          <li data-kid=\"145\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"146\">Contact</a></li>\n          <li data-kid=\"147\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"148\">Terms</a></li>\n          <li data-kid=\"149\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"150\">Privacy</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4\" data-kid=\"151\">\n      <p class=\"text-white/20 text-xs tracking-widest\" data-kid=\"152\">© 2026 ONMOVE INTERFACE. ALL RIGHTS RESERVED.</p>\n      <div class=\"flex gap-6 text-white/40\" data-kid=\"153\">\n        <i class=\"ti ti-brand-twitter hover:text-gold cursor-pointer\" data-kid=\"154\"></i>\n        <i class=\"ti ti-brand-linkedin hover:text-gold cursor-pointer\" data-kid=\"155\"></i>\n        <i class=\"ti ti-brand-instagram hover:text-gold cursor-pointer\" data-kid=\"156\"></i>\n      </div>\n    </div>\n  </footer>\n</div>",
